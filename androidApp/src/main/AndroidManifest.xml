<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      enableOnBackInvokedCallback is what makes back predictive: the drawer
      and the sheets follow the gesture out instead of vanishing when it
      completes. Every back handler in the app is registered through the
      activity's dispatcher, which is what the flag needs.
    -->
    <application
        android:label="Skema"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true">

        <!--
          configChanges is what makes folding seamless rather than a blink.

          Without it the hinge is an ordinary configuration change: Android
          destroys the Activity and builds a new one, so the app restarts,
          loses the scroll position and the selected day, and refetches. With
          it the process keeps running and Compose simply recomposes against
          the new constraints, which is the same code path as a desktop window
          resize. Every axis the fold actually moves has to be listed: the
          Pixel Fold changes width, height, screen layout and orientation in
          one step, and one missing flag is enough to bring the restart back.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|layoutDirection"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
